
<!DOCTYPE html>
<html lang="mn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>ГЭРЭЛТ | Хятад хэлний академи</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --gold:#b38a42;
  --gold-light:#ead8b2;
  --dark:#28251f;
  --bg:#fbfaf7;
  --white:#fff;
  --muted:#77736b;
  --border:#eee9df;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--dark);
  font-family:Arial,sans-serif;
}
button,input,textarea{font:inherit}
button{cursor:pointer}
header{
  height:70px;background:white;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 5%;position:sticky;top:0;z-index:5;
}
.logo{font-size:25px;font-weight:900;letter-spacing:4px;color:var(--gold)}
.nav{display:flex;gap:9px;align-items:center}
.btn{
  border:0;border-radius:9px;padding:12px 17px;font-weight:bold;
}
.primary{background:var(--gold);color:white}
.secondary{background:white;border:1px solid var(--gold);color:var(--gold)}
.light{background:#f5f0e6;color:var(--dark)}
.hero{
  padding:75px 20px;text-align:center;
  background:linear-gradient(130deg,#fff,#f5ecd9);
}
.hero h1{font-size:clamp(30px,5vw,48px);margin:15px 0}
.hero p{color:var(--muted);line-height:1.8}
.hero .logo{font-size:36px}
.container{max-width:1120px;margin:auto;padding:35px 20px}
h2{color:var(--gold)}
.grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
}
.card{
  background:white;border:1px solid var(--border);
  border-radius:15px;padding:20px;
  box-shadow:0 5px 20px #00000006;
}
.card h3{margin-top:9px}
.chinese{font-size:29px;color:var(--gold)}
.muted{color:var(--muted);line-height:1.6}
.tag{font-size:11px;font-weight:bold;color:var(--gold)}
.price{font-size:34px;font-weight:900;color:var(--gold)}
input,textarea{
  width:100%;padding:13px;margin:7px 0;
  border:1px solid #ded9d0;border-radius:9px;background:white;
}
textarea{min-height:100px;resize:vertical}
label{font-size:13px;font-weight:bold}
.page{display:none}
.page.active{display:block}
.modal{
  display:none;position:fixed;inset:0;background:#0008;
  z-index:10;align-items:center;justify-content:center;padding:18px;
}
.modal.show{display:flex}
.modalbox{
  background:white;width:100%;max-width:430px;
  padding:25px;border-radius:17px;max-height:90vh;overflow:auto;
}
.modalbox h2{margin-top:0}
.close{float:right;background:#f3f0ea;border:0;border-radius:8px;padding:8px}
.lesson-row{
  display:flex;justify-content:space-between;align-items:center;
  gap:10px;flex-wrap:wrap;
}
.hidden{display:none!important}
.notice{
  background:#f7f0e2;padding:14px;border-radius:10px;
  border:1px solid var(--gold-light);line-height:1.6;
}
footer{
  text-align:center;background:#28251f;color:white;padding:30px;
  margin-top:40px;
}
.menu{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.status{font-size:12px;color:var(--muted)}
@media(max-width:600px){
 header{padding:0 14px}
 .logo{font-size:21px}
 .hero{padding:50px 18px}
 .container{padding:25px 15px}
}
</style>
</head>
<body>

<header>
  <div class="logo">ГЭРЭЛТ</div>
  <div class="nav">
    <button class="btn secondary" onclick="openAuth('login')">Нэвтрэх</button>
    <button class="btn primary" onclick="openAuth('register')">Бүртгүүлэх</button>
  </div>
</header>

<main id="publicPage">
  <section class="hero">
    <div class="logo">ГЭРЭЛТ</div>
    <h1>Хятад хэлийг монгол хэлээр сурцгаая</h1>
    <p>Мэдлэгт хүрэх гэрэлтэй аялал эндээс эхэлнэ.<br>
    Анхан шатнаас эхлэн өөрийн хурдаар суралцаарай.</p>
    <button class="btn primary" onclick="document.getElementById('courses').scrollIntoView({behavior:'smooth'})">
      Хичээлүүд үзэх
    </button>
  </section>

  <section class="container">
    <h2>ГЭРЭЛТ сургалтын давуу тал</h2>
    <div class="grid">
      <div class="card"><div class="chinese">你好</div><h3>100 хичээл</h3><p class="muted">Анхан шатнаас ахисан түвшин хүртэл.</p></div>
      <div class="card"><div class="chinese">老师</div><h3>AI багш</h3><p class="muted">Асуулт, тайлбар, дасгал, ярианы дадлага.</p></div>
      <div class="card"><div class="chinese">学习</div><h3>Дасгал, шалгалт</h3><p class="muted">Сурсан зүйлээ бататгаж, ахицаа хяна.</p></div>
    </div>
  </section>

  <section class="container" id="courses">
    <h2>100 хичээлийн хөтөлбөр</h2>
    <p class="muted">Эхний 3 хичээл үнэгүй. Бусад 97 хичээл Premium эрхтэй.</p>
    <div class="grid" id="publicLessons"></div>
  </section>

  <section class="container">
    <div class="card" style="text-align:center">
      <h2>ГЭРЭЛТ Premium</h2>
      <div class="price">50,000₮</div>
      <p>30 хоногийн эрх</p>
      <p class="muted">100 хичээл · Видео · Аудио · Дасгал · Шалгалт · Хувийн чат</p>
      <button class="btn primary" onclick="openAuth('register')">Суралцаж эхлэх</button>
    </div>
  </section>
</main>

<main id="studentPage" class="page">
  <section class="container">
    <div class="card">
      <div class="lesson-row">
        <div><div class="tag">МИНИЙ БҮРТГЭЛ</div><h2 id="studentName">Сурагч</h2></div>
        <button class="btn secondary" onclick="logout()">Гарах</button>
      </div>
      <p>Таны сурагчийн ID:</p>
      <h2 id="studentCode">Уншиж байна...</h2>
      <p id="premiumStatus" class="notice">Эрхийн мэдээлэл уншиж байна...</p>
    </div>

    <div class="menu" style="margin-top:20px">
      <button class="btn light" onclick="showStudentTab('myLessons')">Хичээлүүд</button>
      <button class="btn light" onclick="showStudentTab('payment')">Premium авах</button>
      <button class="btn light" onclick="showStudentTab('chat')">Хувийн чат</button>
      <button class="btn light" onclick="showStudentTab('ai')">AI багш</button>
    </div>

    <div id="myLessons" class="student-tab">
      <h2>Миний хичээлүүд</h2>
      <div class="grid" id="studentLessons"></div>
    </div>

    <div id="payment" class="student-tab hidden">
      <div class="card">
        <h2>Premium эрх авах</h2>
        <div class="price">50,000₮ / 30 хоног</div>
        <div id="bankDetails" class="notice">Төлбөрийн зааврыг уншиж байна...</div>
        <p class="muted">Шилжүүлгийн утга дээр өөрийн сурагчийн ID-г заавал бичээрэй.</p>
        <label>Гүйлгээний дугаар / лавлах утга</label>
        <input id="transferReference" placeholder="Гүйлгээний дугаар">
        <button class="btn primary" onclick="submitPayment()">Төлбөрийн мэдэгдэл илгээх</button>
        <p id="paymentMessage" class="status"></p>
      </div>
    </div>

    <div id="chat" class="student-tab hidden">
      <div class="card">
        <h2>Хувийн чат</h2>
        <p class="muted">Сурагчид хоорондын хувийн мессежийн систем дараагийн холболтоор идэвхжинэ.</p>
      </div>
    </div>

    <div id="ai" class="student-tab hidden">
      <div class="card">
        <h2>ГЭРЭЛТ AI багш</h2>
        <p class="muted">Хятад хэлний асуулт, дасгал, дуудлага, ярианы дадлага.</p>
        <textarea id="aiQuestion" placeholder="Багшаасаа асуух зүйлээ бичээрэй..."></textarea>
        <button class="btn primary" onclick="askAI()">Асуулт илгээх</button>
        <p id="aiMessage" class="status">AI үйлчилгээний сервер холбогдоогүй байна.</p>
      </div>
    </div>
  </section>
</main>

<main id="adminPage" class="page">
  <section class="container">
    <div class="lesson-row">
      <h1 style="color:var(--gold)">GERELT ADMIN</h1>
      <button class="btn secondary" onclick="logout()">Гарах</button>
    </div>
    <div class="notice">Админы удирдлагын самбар. Зөвхөн серверээс баталгаажсан админ ашиглана.</div>
    <div class="menu" style="margin-top:20px">
      <button class="btn light" onclick="showAdminTab('adminHome')">Тойм</button>
      <button class="btn light" onclick="showAdminTab('adminPayments')">Төлбөр</button>
      <button class="btn light" onclick="showAdminTab('adminBank')">Банк</button>
      <button class="btn light" onclick="showAdminTab('adminLessons')">Хичээл</button>
      <button class="btn light" onclick="showAdminTab('adminStudents')">Сурагчид</button>
    </div>
    <div id="adminHome" class="admin-tab">
      <div class="grid">
        <div class="card"><h3>100</h3><p>Нийт хичээл</p></div>
        <div class="card"><h3>50,000₮</h3><p>Сарын Premium үнэ</p></div>
        <div class="card"><h3>3</h3><p>Үнэгүй хичээл</p></div>
      </div>
    </div>
    <div id="adminPayments" class="admin-tab hidden">
      <div class="card"><h2>Төлбөрийн хүсэлтүүд</h2><div id="adminPaymentList">Уншиж байна...</div></div>
    </div>
    <div id="adminBank" class="admin-tab hidden">
      <div class="card">
        <h2>Банкны мэдээлэл</h2>
        <label>Банкны нэр</label><input id="bankName">
        <label>Данс эзэмшигч</label><input id="accountName">
        <label>Дансны дугаар</label><input id="accountNumber">
        <label>Төлбөрийн заавар</label><textarea id="bankInstructions"></textarea>
        <button class="btn primary" onclick="saveBank()">Хадгалах</button>
        <p id="bankMessage"></p>
      </div>
    </div>
    <div id="adminLessons" class="admin-tab hidden">
      <div class="card"><h2>Хичээл удирдах</h2><p>Хичээлийн видео, зураг, аудио, дасгал нэмэх удирдлагыг дараагийн серверийн холболтоор идэвхжүүлнэ.</p></div>
    </div>
    <div id="adminStudents" class="admin-tab hidden">
      <div class="card"><h2>Сурагчид</h2><div id="adminStudentList">Уншиж байна...</div></div>
    </div>
  </section>
</main>

<footer>
  <div class="logo">ГЭРЭЛТ</div>
  <p>Хятад хэл сурах гэрэлтэй аялал.</p>
  <p>© 2026 ГЭРЭЛТ</p>
</footer>

<div class="modal" id="authModal">
  <div class="modalbox">
    <button class="close" onclick="closeAuth()">✕</button>
    <h2 id="authTitle">Бүртгүүлэх</h2>
    <div id="registerFields">
      <label>Таны нэр</label>
      <input id="regName" placeholder="Овог, нэр">
      <label>Утасны дугаар</label>
      <input id="regPhone" type="tel" placeholder="+976...">
    </div>
    <div id="loginFields" class="hidden">
      <label>Утасны дугаар</label>
      <input id="loginPhone" type="tel" placeholder="+976...">
    </div>
    <label>Нууц үг</label>
    <input id="authPassword" type="password" placeholder="Нууц үг">
    <button class="btn primary" style="width:100%;margin-top:10px" onclick="submitAuth()">Үргэлжлүүлэх</button>
    <p id="authMessage" class="status"></p>
    <p class="muted" style="font-size:13px">Нууц үгээ мартсан бол админтай холбогдоно уу.</p>
  </div>
</div>

<script>
/* ГЭРЭЛТ-ийн Supabase холболт */
const SUPABASE_URL = "https://quejpmdgwombhcufmftg.supabase.co";
const SUPABASE_KEY = "sb_publishable_IF3-wfIdTIx_zyiruyLLNQ_wO7bRHma";

const db = window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

let currentUser = null;
let currentProfile = null;
let authMode = "register";

const lessonNames = [
"Мэндлэх","Тоонууд","Үйл үг","Өөрийгөө танилцуулах","Гэр бүл",
"Цаг хугацаа","Өдөр тутмын амьдрал","Хоол хүнс","Ундаа","Жимс ногоо",
"Дэлгүүр","Үнэ асуух","Өнгө","Хувцас","Гэр орон",
"Сургууль","Ажил мэргэжил","Найз нөхөд","Улс орон","Хэл сурах",
"Тээврийн хэрэгсэл","Автобус","Галт тэрэг","Такси","Онгоц",
"Зочид буудал","Ресторан","Эмнэлэг","Эмийн сан","Биеийн хэсэг",
"Цаг агаар","Улирал","Амралт","Аялал","Чиглэл асуух",
"Байршил","Хот","Тосгон","Банк","Мөнгө",
"Утас","Интернет","Компьютер","Спорт","Хобби",
"Дуртай зүйл","Сэтгэл хөдлөл","Өдөр тутмын яриа","Асуулт асуух","Үгүйсгэх",
"Өнгөрсөн цаг","Одоо цаг","Ирээдүй цаг","Тэмдэг нэр","Дайвар үг",
"Холбоос үг","Өгүүлбэр зохиох","Ярианы дадлага","Сонсголын дасгал","Унших дасгал",
"Бичих дасгал","Дуудлага","Pinyin","Ханз бичих","Түгээмэл хэллэг",
"Захиалга өгөх","Худалдаа хийх","Ажилд орох","Ярилцлага","Албан харилцаа",
"Нисэх буудал","Хил гааль","Аяллын яриа","Зочин угтах","Уулзалт товлох",
"Цаг товлох","Асуудал тайлбарлах","Тусламж хүсэх","Яаралтай нөхцөл","Эелдэг харилцаа",
"Хятад соёл","Баяр ёслол","Хоолны соёл","Хотын амьдрал","Ажлын орчин",
"Дунд шатны яриа","Урт өгүүлбэр","Харилцан яриа","Сонсголын шалгалт","Үгийн шалгалт",
"Ханзны шалгалт","Дүрмийн шалгалт","Ярианы шалгалт","Давтлага","Эцсийн шалгалт"
];

function renderPublicLessons(){
  const root=document.getElementById("publicLessons");
  lessonNames.forEach((name,i)=>{
    const free=i<3;
    root.innerHTML+=`<div class="card">
      <div class="tag">${free?"ҮНЭГҮЙ":"🔒 PREMIUM"}</div>
      <h3>${i+1}. ${name}</h3>
      <p class="muted">${free?"Үнэгүй хичээл":"Premium эрх шаардлагатай"}</p>
      <button class="btn ${free?"secondary":"primary"}" onclick="openAuth('login')">
        ${free?"Нэвтэрч үзэх":"Түгжээтэй"}
      </button>
    </div>`;
  });
}

function openAuth(mode){
  authMode=mode;
  document.getElementById("authModal").classList.add("show");
  document.getElementById("authTitle").textContent=mode==="register"?"Сурагч бүртгүүлэх":"Сурагч нэвтрэх";
  document.getElementById("registerFields").classList.toggle("hidden",mode!=="register");
  document.getElementById("loginFields").classList.toggle("hidden",mode!=="login");
  document.getElementById("authMessage").textContent="";
}
function closeAuth(){document.getElementById("authModal").classList.remove("show")}

async function submitAuth(){
  const password=document.getElementById("authPassword").value.trim();
  const msg=document.getElementById("authMessage");
  if(password.length<8){msg.textContent="Нууц үг дор хаяж 8 тэмдэгт байна.";return}
  try{
    if(authMode==="register"){
      const name=document.getElementById("regName").value.trim();
      const phone=document.getElementById("regPhone").value.trim();
      if(!name||!phone){msg.textContent="Нэр, утсаа бүрэн оруулна уу.";return}
      const {data,error}=await db.auth.signUp({
        phone,password,
        options:{data:{full_name:name}}
      });
      if(error)throw error;
      msg.textContent=data.session?"Бүртгэл амжилттай.":"Бүртгэл үүслээ. Утас баталгаажуулах тохиргоо шаардлагатай байж болно.";
      if(data.session){currentUser=data.user;await loadProfile()}
    }else{
      const phone=document.getElementById("loginPhone").value.trim();
      const {data,error}=await db.auth.signInWithPassword({phone,password});
      if(error)throw error;
      currentUser=data.user;
      closeAuth();
      await loadProfile();
    }
  }catch(e){msg.textContent="Алдаа: "+e.message}
}

async function loadProfile(){
  const {data,error}=await db.from("profiles")
    .select("id,full_name,student_code,role,premium_until")
    .eq("id",currentUser.id).single();
  if(error){alert("Бүртгэлийн мэдээлэл уншигдсангүй: "+error.message);return}
  currentProfile=data;
  document.getElementById("publicPage").classList.add("hidden");
  if(data.role==="admin"){
    document.getElementById("adminPage").classList.add("active");
    document.getElementById("studentPage").classList.remove("active");
    loadAdmin();
  }else{
    document.getElementById("studentPage").classList.add("active");
    document.getElementById("adminPage").classList.remove("active");
    document.getElementById("studentName").textContent=data.full_name||"Сурагч";
    document.getElementById("studentCode").textContent=data.student_code;
    const active=data.premium_until&&new Date(data.premium_until)>new Date();
    document.getElementById("premiumStatus").textContent=active?
      "Premium эрх хүчинтэй: "+new Date(data.premium_until).toLocaleDateString("mn-MN"):
      "Үнэгүй эрх. Premium авахын тулд төлбөр төлнө үү.";
    loadStudentLessons();
    loadBank();
  }
}

async function loadStudentLessons(){
  const {data,error}=await db.from("lessons").select("*").eq("is_published",true).order("lesson_number");
  const root=document.getElementById("studentLessons");
  root.innerHTML="";
  if(error){root.textContent="Хичээл уншихад алдаа гарлаа.";return}
  data.forEach(l=>{
    const free=l.is_free;
    const active=currentProfile.premium_until&&new Date(currentProfile.premium_until)>new Date();
    const allowed=free||currentProfile.role==="admin"||active;
    root.innerHTML+=`<div class="card">
      <div class="tag">${free?"ҮНЭГҮЙ":allowed?"PREMIUM НЭЭЛТТЭЙ":"🔒 PREMIUM"}</div>
      <h3>${l.lesson_number}. ${escapeHTML(l.title)}</h3>
      <p class="muted">${escapeHTML(l.description||"Хятад хэлний хичээл")}</p>
      <button class="btn ${allowed?"primary":"secondary"}" onclick="openLesson(${l.id},${allowed})">${allowed?"Хичээл үзэх":"Premium авах"}</button>
    </div>`;
  });
}

async function openLesson(id,allowed){
  if(!allowed){showStudentTab("payment");return}
  const {data,error}=await db.from("lesson_contents").select("*").eq("lesson_id",id);
  if(error){alert(error.message);return}
  if(!data.length){alert("Энэ хичээлийн агуулгыг админ хараахан оруулаагүй байна.");return}
  const item=data[0];
  let html=item.content||"";
  if(item.video_url)html+="<p><video controls style='width:100%' src='"+escapeHTML(item.video_url)+"'></video></p>";
  if(item.image_url)html+="<p><img style='max-width:100%' src='"+escapeHTML(item.image_url)+"'></p>";
  if(item.audio_url)html+="<p><audio controls src='"+escapeHTML(item.audio_url)+"'></audio></p>";
  const w=window.open("","_blank");
  w.document.write("<meta name='viewport' content='width=device-width'><body style='font-family:Arial;padding:20px'>"+html+"</body>");
}

function showStudentTab(id){
  document.querySelectorAll(".student-tab").forEach(x=>x.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
}

async function loadBank(){
  const {data}=await db.from("payment_settings").select("*").eq("id",true).maybeSingle();
  const box=document.getElementById("bankDetails");
  if(!data){box.textContent="Админ банкны мэдээллээ хараахан оруулаагүй байна.";return}
  box.innerHTML=`Банк: ${escapeHTML(data.bank_name||"")}<br>Данс эзэмшигч: ${escapeHTML(data.account_name||"")}<br>Данс: ${escapeHTML(data.account_number||"")}<br>${escapeHTML(data.instructions||"")}<br><b>Гүйлгээний утга: ${escapeHTML(currentProfile.student_code)}</b>`;
}

async function submitPayment(){
  const reference=document.getElementById("transferReference").value.trim();
  const msg=document.getElementById("paymentMessage");
  if(!reference){msg.textContent="Гүйлгээний дугаар эсвэл лавлах утгаа оруулна уу.";return}
  const {error}=await db.from("payment_requests").insert({
    user_id:currentUser.id,
    student_code:currentProfile.student_code,
    amount:50000,
    transfer_reference:reference
  });
  msg.textContent=error?"Илгээхэд алдаа гарлаа: "+error.message:"Төлбөрийн мэдэгдэл илгээгдлээ. Админ шалгаж батална.";
}

async function loadAdmin(){
  const {data:payments}=await db.from("payment_requests").select("*").order("created_at",{ascending:false});
  const root=document.getElementById("adminPaymentList");
  root.innerHTML="";
  (payments||[]).forEach(p=>{
    root.innerHTML+=`<div class="card"><b>${escapeHTML(p.student_code)}</b><p>${p.amount}₮ · ${escapeHTML(p.transfer_reference)}</p><p>Төлөв: ${escapeHTML(p.status)}</p></div>`;
  });
  const {data:students}=await db.from("profiles").select("full_name,student_code,role,premium_until").order("created_at",{ascending:false});
  document.getElementById("adminStudentList").innerHTML=(students||[]).map(s=>
    `<div class="card"><b>${escapeHTML(s.full_name||"")}</b><p>${escapeHTML(s.student_code||"")} · ${escapeHTML(s.role)}</p><p>${s.premium_until?new Date(s.premium_until).toLocaleDateString("mn-MN"):"Premium эрхгүй"}</p></div>`
  ).join("");
  const {data:bank}=await db.from("payment_settings").select("*").eq("id",true).maybeSingle();
  if(bank){
    document.getElementById("bankName").value=bank.bank_name||"";
    document.getElementById("accountName").value=bank.account_name||"";
    document.getElementById("accountNumber").value=bank.account_number||"";
    document.getElementById("bankInstructions").value=bank.instructions||"";
  }
}

async function saveBank(){
  const {error}=await db.from("payment_settings").update({
    bank_name:document.getElementById("bankName").value,
    account_name:document.getElementById("accountName").value,
    account_number:document.getElementById("accountNumber").value,
    instructions:document.getElementById("bankInstructions").value
  }).eq("id",true);
  document.getElementById("bankMessage").textContent=error?error.message:"Банкны мэдээлэл хадгалагдлаа.";
}

function showAdminTab(id){
  document.querySelectorAll(".admin-tab").forEach(x=>x.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
}
function askAI(){
  document.getElementById("aiMessage").textContent=
    "AI багшийн сервер/API холболтыг хийх шаардлагатай. Одоогоор асуулт илгээх үйлчилгээ идэвхгүй.";
}
function escapeHTML(value){
  return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
async function logout(){
  await db.auth.signOut();
  currentUser=null;currentProfile=null;
  document.getElementById("studentPage").classList.remove("active");
  document.getElementById("adminPage").classList.remove("active");
  document.getElementById("publicPage").classList.remove("hidden");
}
async function init(){
  renderPublicLessons();
  const {data}=await db.auth.getSession();
  if(data.session){currentUser=data.session.user;await loadProfile()}
}
init();
</script>
</body>
</html>
